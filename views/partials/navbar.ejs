<!-- Top navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-navbar shadow-sm">
  <div class="container-fluid">
    <button class="btn btn-outline-light me-2" id="sidebarToggle" aria-label="Toggle sidebar">
      <span class="navbar-toggler-icon"></span>
    </button>
    <a class="navbar-brand" href="/">Supermarket App</a>

    <div class="ms-auto d-flex align-items-center">
      <% if (!user) { %>
        <a class="btn btn-sm btn-light me-2" href="/register">Register</a>
        <a class="btn btn-sm btn-light" href="/login">Login</a>
      <% } else { %>
        <span class="me-3 text-light">Hello, <strong><%= user.username %></strong></span>
        <button id="chatToggle" class="btn btn-sm btn-outline-light me-2">Chat</button>
        <a class="btn btn-sm btn-outline-light" href="/logout">Logout</a>
      <% } %>
    </div>
  </div>
</nav>

<!-- Sidebar + main layout wrapper -->
<div class="d-flex" id="layoutWrapper">
  <aside id="appSidebar" class="bg-light border-end sidebar-collapse">
    <div class="sidebar-sticky p-3">
      <h5 class="sidebar-title">Menu</h5>
      <ul class="nav flex-column">
        <% if (!user) { %>
          <li class="nav-item"><a class="nav-link" href="/register">Register</a></li>
          <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
        <% } else if (user.role === 'admin') { %>
          <li class="nav-item"><a class="nav-link" href="/inventory">Inventory</a></li>
          <li class="nav-item"><a class="nav-link" href="/addProduct">Add Product</a></li>
          <li class="nav-item"><a class="nav-link" href="/users">Users</a></li>
          <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/shopping">Shop</a></li>
          <li class="nav-item"><a class="nav-link" href="/cart">Cart</a></li>
          <li class="nav-item"><a class="nav-link" href="/order-history">Orders</a></li>
          <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        <% } %>
      </ul>
    </div>
  </aside>

  <main id="appMain" class="flex-grow-1 p-4">
    <!-- main content starts here; individual views render inside this area -->
    <div id="mainContent">
    </div>
  </main>
</div>

<script>
  // Sidebar toggle script (keeps layout client-side only)
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('appSidebar');
    toggle && toggle.addEventListener('click', function() {
      sidebar.classList.toggle('collapsed');
    });
  });
</script>
