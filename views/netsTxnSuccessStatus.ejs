<%- include('partials/head') %>
<%- include('partials/navbar', { user: (typeof user !== 'undefined' ? user : null) }) %>

<div class="container">
  <div id="mainContent">
    <div class="text-center mt-3">
      <div class="alert alert-success" role="alert">
        <h2 class="mb-3">NETS Payment Successful</h2>
        <p><%= message %></p>
        <% if (txnRetrievalRef) { %>
          <div class="text-muted">Transaction Ref: <%= txnRetrievalRef %></div>
        <% } %>
      </div>
    </div>

    <div class="mt-4 text-center">
      <form action="/checkout/nets/confirm" method="POST" style="display:inline;">
        <input type="hidden" name="payment_method" value="nets">
        <button type="submit" class="btn btn-success">Finalize Order</button>
      </form>
      <a href="/cart" class="btn btn-secondary ms-2">Back to Cart</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
