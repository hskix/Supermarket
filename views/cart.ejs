<%- include('partials/head') %>
<%- include('partials/navbar', { user: (typeof user !== 'undefined' ? user : null) }) %>

<div class="container">
  <div id="mainContent">
    <div class="welcome-text">Welcome, <strong><%= user.username %></strong></div>
    <h2 class="page-title">Shopping Cart</h2>

    <% if (cart.length === 0) { %>
      <div class="alert alert-info" role="alert">Your cart is empty. <a href="/shopping">Continue shopping</a></div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Product</th>
              <th width="80">Image</th>
              <th width="100">Quantity</th>
              <th width="100">Price</th>
              <th width="100">Total</th>
              <th width="80">Action</th>
            </tr>
          </thead>
          <tbody>
            <% let total = 0; %>
            <% cart.forEach(item => { %>
              <tr>
                <td><strong><%= item.productName %></strong></td>
                <td><img src="/images/<%= item.image %>" alt="<%= item.productName %>" style="width:60px;height:60px;object-fit:cover;border-radius:5px;"></td>
                <td>
                  <form action="/update-quantity/<%= item.product_id %>" method="POST" class="d-flex gap-2">
                    <input type="number" name="quantity" value="<%= item.quantity %>" min="1" class="form-control form-control-sm" style="width:70px;">
                    <button class="btn btn-sm btn-primary">Update</button>
                  </form>
                </td>
                <td>$<%= parseFloat(item.unit_price).toFixed(2) %></td>
                <td><strong>$<%= (item.unit_price * item.quantity).toFixed(2) %></strong></td>
                <td><a href="/remove-from-cart/<%= item.product_id %>" class="btn btn-sm btn-danger" onclick="return confirm('Remove from cart?')">Remove</a></td>
              </tr>
              <% total += item.unit_price * item.quantity; %>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="mt-4">
        <div class="alert alert-light" role="alert">
          <h5 class="mb-0">Subtotal: <strong style="float:right;color:var(--accent);">$<%= total.toFixed(2) %></strong></h5>
        </div>
      </div>

      <div class="mt-4 text-center">
        <a href="/shopping" class="btn btn-secondary me-2">← Continue Shopping</a>
        <form action="/checkout" method="POST" style="display:inline;">
          <div class="mb-2 text-start">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="payment_method" id="payment-paypal" value="paypal" checked>
              <label class="form-check-label" for="payment-paypal">PayPal</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="payment_method" id="payment-nets" value="nets">
              <label class="form-check-label" for="payment-nets">NETS QR</label>
            </div>
          </div>
          <button type="submit" class="btn btn-success">Proceed to Checkout</button>
        </form>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>


