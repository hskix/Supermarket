<%- include('partials/head') %>
<%- include('partials/navbar', { user: (typeof user !== 'undefined' ? user : null) }) %>

<div class="container">
  <div id="mainContent">
    <div class="welcome-text mb-3">Welcome, <strong><%= user.username %></strong> (<span class="badge bg-info"><%= user.role %></span>)</div>
    <h2 class="page-title">Product Details</h2>

    <% if (product) { %>
      <div class="row mt-4">
        <div class="col-md-5">
          <div class="card">
            <img src="/images/<%= product.image %>" class="card-img-top" alt="<%= product.productName %>" style="height:300px; object-fit:cover;">
          </div>
        </div>
        <div class="col-md-7">
          <div class="card p-4">
            <h3 class="mb-3"><strong><%= product.productName %></strong></h3>
            <div class="mb-3">
              <label class="form-label text-muted">Price</label>
              <h4 class="text-success">$<%= product.price.toFixed(2) %></h4>
            </div>
            <div class="mb-3">
              <label class="form-label text-muted">Stock Status</label>
              <% if (product.quantity > 0) { %>
                <span class="badge bg-success" style="font-size:1rem;"><%= product.quantity %> in stock</span>
              <% } else { %>
                <span class="badge bg-danger" style="font-size:1rem;">Out of stock</span>
              <% } %>
            </div>
            <div class="mt-4">
              <% if (user.role === "admin") { %>
                <a href="/inventory" class="btn btn-secondary">← Back to Inventory</a>
              <% } else { %>
                <a href="/shopping" class="btn btn-secondary">← Continue Shopping</a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="alert alert-warning mt-4"><p class="mb-0">No product found.</p></div>
      <div class="mt-3">
        <% if (user.role === "admin") { %>
          <a href="/inventory" class="btn btn-secondary">← Back to Inventory</a>
        <% } else { %>
          <a href="/shopping" class="btn btn-secondary">← Back to Shop</a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

