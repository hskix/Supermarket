<%- include('partials/head') %>
<%- include('partials/navbar', { user: (typeof user !== 'undefined' ? user : null) }) %>

<div class="container">
  <div id="mainContent">
    <div class="welcome-text">Welcome, <strong><%= (user && user.username) ? user.username : 'Admin' %></strong> (<%= (user && user.role) ? user.role : '' %>)</div>
    <h2 class="page-title">Inventory Management</h2>

    <% if (products && products.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr>
              <th width="150">Product Name</th>
              <th width="100">Image</th>
              <th width="80">Quantity</th>
              <th width="80">Price</th>
              <th width="60">Edit</th>
              <th width="60">Delete</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(p => { %>
              <tr>
                <td><strong><a href="/product/<%= p.id %>" style="text-decoration: none; color: var(--pink-700);"><%= p.productName %></a></strong></td>
                <td><img src="/images/<%= p.image %>" alt="<%= p.productName %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;"></td>
                <td><span class="badge <%= p.quantity <= 5 ? 'bg-warning' : 'bg-success' %>"><%= p.quantity %></span></td>
                <td><strong>$<%= (typeof p.price === 'number' ? p.price : Number(p.price || 0)).toFixed(2) %></strong></td>
                <td><a href="/updateProduct/<%= p.id %>" class="btn btn-sm btn-info">Edit</a></td>
                <td><a href="/deleteProduct/<%= p.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Delete this product?')">Delete</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-info" role="alert">
        No products found. <a href="/addProduct">Add your first product</a>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

