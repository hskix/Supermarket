<%- include('partials/head') %>
<%- include('partials/navbar', { user: (typeof user !== 'undefined' ? user : null) }) %>

<div class="container">
  <div id="mainContent">
    <h2 class="page-title">Manage Users</h2>
    <div class="row gap-3 mb-4">
      <div class="col-md-3"><div class="stat-card"><h3><%= users && users.length ? users.length : 0 %></h3><p>Total Users</p></div></div>
      <div class="col-md-3"><div class="stat-card"><h3><%= users && users.filter ? users.filter(u => u.role === 'customer' || u.role === 'user').length : 0 %></h3><p>Customers</p></div></div>
      <div class="col-md-3"><div class="stat-card"><h3><%= users && users.filter ? users.filter(u => u.role === 'admin').length : 0 %></h3><p>Admins</p></div></div>
    </div>

    <div class="mb-3 d-flex justify-content-end gap-2">
      <label for="userSort" class="form-label mb-0 align-self-center">Sort:</label>
      <select id="userSort" class="form-select" style="width:220px;">
        <option value="username-asc">Username A → Z</option>
        <option value="username-desc">Username Z → A</option>
        <option value="registered-asc">Registered ↑</option>
        <option value="registered-desc">Registered ↓</option>
      </select>
    </div>

    <% if (users && users.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead>
            <tr><th>ID</th><th>Username</th><th>Email</th><th>Contact</th><th>Role</th><th>Registered</th><th>Action</th></tr>
          </thead>
          <tbody>
                <% users.forEach(u => { %>
              <tr>
                <td><strong>#<%= u.id %></strong></td>
                <td><%= u.username %></td>
                <td><%= u.email %></td>
                <td><%= u.contact || 'N/A' %></td>
                <td>
                  <% if (u.role === 'admin') { %>
                    <span class="badge badge-admin">ADMIN</span>
                  <% } else { %>
                    <span class="badge badge-customer">CUSTOMER</span>
                  <% } %>
                </td>
                <td><%= u.created_at ? new Date(u.created_at).toLocaleDateString() : 'N/A' %></td>
                <td>
                  <% if (u.id !== user.id && u.role !== 'admin') { %>
                    <a href="/delete-user/<%= u.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this user?')">Delete</a>
                  <% } else if (u.id === user.id) { %>
                    <span class="badge bg-secondary">Current User</span>
                  <% } else if (u.role === 'admin') { %>
                    <span class="badge bg-secondary">Cannot delete</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-info mt-4"><p class="mb-0">No users found.</p></div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

<script>
  // Client-side sorting for users table
  document.addEventListener('DOMContentLoaded', function(){
    const sel = document.getElementById('userSort');
    if (!sel) return;
    sel.addEventListener('change', function(){
      const val = sel.value;
      const tbody = document.querySelector('table.table tbody');
      if (!tbody) return;
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const compare = (a,b,fn,asc=true) => {
        const va = fn(a); const vb = fn(b);
        if (va < vb) return asc ? -1 : 1;
        if (va > vb) return asc ? 1 : -1;
        return 0;
      };
      let sorted;
      if (val === 'username-asc' || val === 'username-desc') {
        sorted = rows.sort((r1,r2) => compare(r1,r2, r => r.cells[1].textContent.trim().toLowerCase(), val==='username-asc'));
      } else if (val === 'registered-asc' || val === 'registered-desc') {
        sorted = rows.sort((r1,r2) => compare(r1,r2, r => new Date(r.cells[5].textContent.trim() || 0).getTime() || 0, val==='registered-asc'));
      }
      if (sorted) {
        tbody.innerHTML = '';
        sorted.forEach(r => tbody.appendChild(r));
      }
    });
  });
</script>
