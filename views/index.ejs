<%- include('partials/head') %>
<%- include('partials/navbar', { user: (typeof user !== 'undefined' ? user : null) }) %>

<div class="container">
  <div id="mainContent">
    <div class="hero text-center mt-3" style="background-image: url('/images/spbg.jpg'); background-size: cover; background-position: center; border-radius:12px; padding:40px;">
      <% if (user) {%>
        <div class="welcome-text mb-4">Welcome, <strong><%= user.username %></strong></div>
        <% if (user.role === "admin") { %>
          <div class="alert alert-info">
            <h3 class="mb-3">Admin Dashboard</h3>
            <p>Manage your inventory and users</p>
            <a href="/inventory" class="btn btn-primary mt-3">Go to Inventory</a>
          </div>
        <% } else { %>
          <div class="alert alert-info">
            <h3 class="mb-3">Ready to Shop?</h3>
            <p>Browse our products and add them to your cart</p>
            <a href="/shopping" class="btn btn-primary mt-3">Start Shopping</a>
          </div>
        <% } %>
        <% } else { %>
        <div class="alert alert-warning" style="margin-top: 40px; background: rgba(255,255,255,0.8);">
          <h2 class="mb-4">Welcome to Supermarket</h2>
          <p class="lead mb-4">Your one-stop shop for all your grocery needs</p>
          <p class="mb-4">Please login or register to get started</p>
          <div class="mt-4">
            <a href="/login" class="btn btn-primary me-2">Login</a>
            <a href="/register" class="btn btn-success">Register</a>
          </div>
        </div>
      <% } %>
    </div>
    </div>
</div>

<%- include('partials/footer') %>

<!-- Ensure Bootstrap JS is loaded -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>